# URL pública https do sistema (o motor do WhatsApp exige https para entregar o webhook)
APP_URL=
# Domínio raiz para subdomínios das lojas (*.ROOT_DOMAIN → /loja/<slug>)
NEXT_PUBLIC_ROOT_DOMAIN=
# Domínios próprios de lojas: host=slug,host=slug
CUSTOM_DOMAINS=

# WhatsApp Whaileys (um número por loja, instâncias cpw-<slug>) — só no servidor
WHAILEYS_API_URL=
WHAILEYS_PARTNER_KEY=
# Chave de 32+ caracteres que cifra as credenciais de cada canal (AES-256-GCM)
CHANNEL_SEAL_KEY=
# Código de ativação que a plataforma entrega ao lojista para criar o canal
WA_PROVISION_KEY=

# Evolution API (provedor 2)
EVOLUTION_API_KEY=

# E-mail transacional
RESEND_API_KEY=

# Fase 2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
