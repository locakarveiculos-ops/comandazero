# =====================================================================
# ComandaZero · variáveis de ambiente
# Copie para .env.local (nunca versionado) e preencha. Na Vercel, cadastre
# em Settings › Environment Variables. Só NEXT_PUBLIC_* chegam ao navegador.
# =====================================================================

# --- Aplicação ---------------------------------------------------------
# URL pública https (o motor do WhatsApp exige https para entregar webhooks)
APP_URL=
# Domínio raiz dos subdomínios das lojas (*.ROOT → /loja/<slug>). Vazio = só /loja/<slug>.
NEXT_PUBLIC_ROOT_DOMAIN=
# Domínios próprios de lojas: host=slug,host=slug
CUSTOM_DOMAINS=
# URL pública do app: links dos e-mails de auth (/auth/callback), canonical e OAuth.
NEXT_PUBLIC_SITE_URL=https://comandazero.vercel.app
# WhatsApp comercial (botão flutuante da landing): 55 + DDD + número
NEXT_PUBLIC_SALES_WHATSAPP=
# "1" mostra "Continuar com Google" (ligar só depois de configurar o provedor no Supabase)
NEXT_PUBLIC_AUTH_GOOGLE=

# --- Supabase (Fase 2: banco, auth e realtime) -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Ignora RLS: nunca expor ao navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Senha do Postgres (migrations/CLI)
SUPABASE_DB_PASSWORD=

# --- WhatsApp · motor Whaileys (botões e listas, um número por loja) ---
WHAILEYS_API_URL=
# Chave de parceiro: só cria/opera instâncias cpw-<slug>
WHAILEYS_PARTNER_KEY=
# 32+ caracteres; cifra as credenciais de cada canal (AES-256-GCM)
CHANNEL_SEAL_KEY=
# Código que a plataforma entrega ao lojista para criar o canal dele
WA_PROVISION_KEY=

# Botões (sendButtons) e listas (sendList) saem pelo motor Whaileys acima.
# O repositório API_-Baileys_Whaileys_Button_list é um bot de IA, sem API HTTP de envio.

# --- WhatsApp · Evolution API (v1/v2) ----------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# v1 ou v2 (formato dos payloads)
EVOLUTION_API_VERSION=v2

# --- E-mail transacional · Resend --------------------------------------
RESEND_API_KEY=

# --- Pagamentos (credencial global; lojas podem usar a própria) --------
# InfinitePay: InfiniteTag do recebedor (checkout link)
INFINITEPAY_HANDLE=
INFINITEPAY_WEBHOOK_SECRET=
# Asaas
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# PagSeguro / PagBank
PAGBANK_TOKEN=
PAGBANK_WEBHOOK_SECRET=
# Ton / Stone (Pagar.me v5)
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=

# Webhooks de pagamento sem o segredo do gateway configurado são recusados (503).

# --- Lojas de demonstração (painel aberto, dados no navegador)
DEMO_TENANTS=cafe-e-flor,burger-station

# --- Infraestrutura ----------------------------------------------------
# DNS wildcard das lojas
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Notificação push (Web Push) ----------------------------------------
# Gere com: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Só no servidor. Trocar invalida as inscrições já feitas.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@comandazero.com.br
